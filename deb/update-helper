#!/bin/sh
# Installs an update the app downloaded and checked. Runs as root through pkexec,
# so it checks again on a copy the user can no longer swap.
set -eu

src=$1
sum=$2
case "$sum" in
  *[!0-9a-f]*) exit 2 ;;
esac
[ ${#sum} -eq 64 ] || exit 2

tmp=$(mktemp)
trap 'rm -f "$tmp"' EXIT
cp -- "$src" "$tmp"
echo "$sum  $tmp" | sha256sum -c --status
[ "$(dpkg-deb -f "$tmp" Package)" = musicunofficial ]
dpkg -i "$tmp"
