#!/bin/sh
# Installs an update the app downloaded. Runs as root through pkexec and trusts
# nothing its caller says: the package must carry a signature made with the
# release key, whose public half the package installed beside this script.
set -eu

key=/opt/MusicUnofficial/resources/update-key.pem
src=$1
sig=$2

# On copies the user can no longer swap.
tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT
cp -- "$src" "$tmp/deb"
cp -- "$sig" "$tmp/sig"
openssl dgst -sha256 -verify "$key" -signature "$tmp/sig" "$tmp/deb" >/dev/null || {
  echo "update: signature does not match" >&2
  exit 3
}
[ "$(dpkg-deb -f "$tmp/deb" Package)" = musicunofficial ]
# A signed but older package would bring its fixed bugs back.
dpkg --compare-versions "$(dpkg-deb -f "$tmp/deb" Version)" gt "$(dpkg-query -W -f='${Version}' musicunofficial)" || {
  echo "update: not newer than the installed version" >&2
  exit 4
}
dpkg -i "$tmp/deb"
