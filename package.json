{
  "name": "musicunofficial",
  "version": "0.0.1",
  "description": "Unofficial desktop wrapper for the YouTube Music player",
  "main": "main.js",
  "license": "MIT",
  "author": {
    "name": "simonlinuxcraft",
    "email": "simonlinuxcraft@pm.me"
  },
  "scripts": {
    "start": "electron .",
    "dev": "unset ELECTRON_RUN_AS_NODE GIO_MODULE_DIR; electron . --no-sandbox --ozone-platform-hint=auto",
    "test": "node --test",
    "smoke": "node scripts/smoke.js",
    "build": "electron-builder --linux && node scripts/swap-runtime.js",
    "build-appimage": "electron-builder --linux AppImage && node scripts/swap-runtime.js",
    "build-deb": "electron-builder --linux deb",
    "icons": "node scripts/gen-icons.js"
  },
  "build": {
    "appId": "io.github.simonlinuxcraft.musicunofficial",
    "productName": "MusicUnofficial",
    "afterPack": "./scripts/after-pack.js",
    "linux": {
      "target": [
        "AppImage"
      ],
      "icon": "icon.png",
      "category": "AudioVideo",
      "synopsis": "Unofficial desktop wrapper for the YouTube Music player",
      "description": "Runs the YouTube Music player (music.youtube.com) in its own window with tray support, media key integration and a frameless interface. Not affiliated with, endorsed by, or sponsored by Google or YouTube.",
      "maintainer": "simonlinuxcraft",
      "syncDesktopName": true,
      "executableName": "musicunofficial"
    },
    "electronLanguages": [
      "en-US",
      "de"
    ],
    "asar": true,
    "asarUnpack": [
      "icon.png",
      "icon-tray.png"
    ],
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "mini/**/*",
      "hybrid/**/*",
      "inject/**/*",
      "icon.png",
      "icon-tray.png",
      "LICENSE",
      "THIRD-PARTY-NOTICES.md",
      "package.json",
      "node_modules/**/*",
      "!node_modules/*/{test,tests,__tests__,docs,doc,example,examples,benchmark,benchmarks}/**",
      "!node_modules/**/*.{md,markdown,ts,map,d.ts,coffee,bak,log,h,c,cc,cpp,gyp,gypi,Makefile,mk}",
      "!node_modules/**/{LICENSE,license,LICENCE,licence,CHANGELOG,changelog,HISTORY,history,AUTHORS,CONTRIBUTORS,NOTICE,README,readme}*",
      "!node_modules/**/{.github,.idea,.vscode,.nyc_output,.eslintrc*,.prettierrc*,.editorconfig,.travis.yml,.gitignore,.gitattributes,.npmignore,tsconfig*.json,jest.config*,karma.conf*,webpack.config*,rollup.config*,gulpfile*,Gruntfile*}",
      "!node_modules/**/*.{md,ts,map,d.ts}"
    ],
    "appImage": {
      "artifactName": "MusicUnofficial-${version}.AppImage"
    }
  },
  "devDependencies": {
    "electron": "^41.7.1",
    "electron-builder": "^26.15.2"
  },
  "desktopName": "musicunofficial.desktop",
  "dependencies": {
    "@homebridge/dbus-native": "0.7.9"
  }
}
